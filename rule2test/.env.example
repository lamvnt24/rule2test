# Template only; the stdlib server reads OS environment, not this file.
# Optional legacy /legacy Ollama adapter:
OLLAMA_MODEL=
# Reserved for future provider implementation (not yet consumed):
OPENAI_API_KEY=
OPENAI_MODEL=

# Phase 1 Settings.from_env Python API; web binding/database use --port and --db instead
RULE2TEST_HOST=127.0.0.1
RULE2TEST_PORT=8000
RULE2TEST_DATABASE_PATH=data/factory.db
RULE2TEST_LLM_PROVIDER=mock
RULE2TEST_REQUEST_TIMEOUT_SECONDS=60

# Phase 6 typed extraction (read directly from process environment)
RULE2TEST_EXTRACTION_PROVIDER=mock
# Required only when extraction provider is ollama; no model is downloaded automatically.
RULE2TEST_EXTRACTION_MODEL=

# Phase 7 retrieval and phase 8 workspace; mock runs offline. Use a matching index after changing providers.
RULE2TEST_EMBEDDING_PROVIDER=mock
RULE2TEST_EMBEDDING_MODEL=
RULE2TEST_EMBEDDING_DIMENSIONS=
RULE2TEST_EMBEDDING_REVISION=
RULE2TEST_SUGGESTION_PROVIDER=mock
RULE2TEST_SUGGESTION_MODEL=


# Phase 8 web workspace: python (offline default) or optional faiss
RULE2TEST_VECTOR_BACKEND=python


# Phase 10: set by run_ai_workspace.py from a validated profile.
# Chat digests identify exact local model artifacts; embedding uses EMBEDDING_REVISION above.
RULE2TEST_EXTRACTION_DIGEST=
RULE2TEST_SUGGESTION_DIGEST=
RULE2TEST_AI_TIMEOUT_SECONDS=60

# Phase 11 diagnostics. Logging is OFF until an entry point calls observability.configure().
# Level: off | debug | info | warn | error. Destination: stderr unless RULE2TEST_LOG_FILE is set.
RULE2TEST_LOG_LEVEL=info
RULE2TEST_LOG_FILE=
